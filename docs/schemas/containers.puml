@startuml containers
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Диаграмма контейнеров «Кинобездна» (To-Be)

Person(user, "Пользователь", "Смотрит фильмы через мобильные устройства, ноутбуки, смарт ТВ")

System_Ext(payment_system, "Платёжная система", "Обработка платежей по подписке")
System_Ext(recommendation, "Внешняя рекомендательная система", "Подборки фильмов")
System_Ext(online_cinemas, "Онлайн-кинотеатры", "Внешние источники контента")
System_Ext(s3, "S3", "Хранилище контента")

System_Boundary(k8s, "Кинобездна (Kubernetes-кластер)") {
    Container(proxy, "API Gateway (proxy-service)", "Python, Flask", "Единая точка входа. Strangler Fig: маршрутизирует трафик между монолитом и микросервисами по фиче-флагу и проценту миграции")

    Container(monolith, "Монолит", "Go", "Домены Users, Payments, Subscriptions (постепенно вымирающий, домены выносятся в микросервисы)")
    Container(movies, "Movies Service", "Go", "Домен Movies: метаданные фильмов, жанры, актёры, рейтинги")
    Container(events, "Events Service", "Python, Flask", "Домен Events: producer и consumer событий User/Payment/Movie (MVP событийной архитектуры)")

    ContainerQueue(kafka, "Kafka", "Apache Kafka", "Шина событий: топики movie-events, user-events, payment-events")
    ContainerDb(db, "PostgreSQL", "PostgreSQL 14", "Данные пользователей, платежей, подписок и метаданные фильмов")
}

Rel(user, proxy, "Использует", "HTTPS/REST via Ingress")

Rel(proxy, monolith, "Проксирует (100 - MOVIES_MIGRATION_PERCENT)% трафика /api/movies и весь трафик users/payments/subscriptions", "HTTP/REST")
Rel(proxy, movies, "Проксирует MOVIES_MIGRATION_PERCENT% трафика /api/movies", "HTTP/REST")
Rel(proxy, events, "Проксирует /api/events", "HTTP/REST")

Rel(monolith, db, "Читает/пишет", "SQL")
Rel(movies, db, "Читает/пишет метаданные", "SQL")

Rel(events, kafka, "Публикует и читает события", "Kafka protocol")

Rel(monolith, payment_system, "Проводит платежи", "HTTPS")
Rel(monolith, recommendation, "Обменивается данными для подборок", "RabbitMQ/AMQP")
Rel(monolith, online_cinemas, "Получает контент", "HTTPS")
Rel(monolith, s3, "Хранит/читает контент", "HTTPS")

SHOW_LEGEND()
@enduml
